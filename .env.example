# ------------------------------------------------------------------
# Copie para .env.local e ajuste.
# ------------------------------------------------------------------

# Banco de dados (Postgres 15+). Em produção use um pooler
# (Neon, Supabase, RDS Proxy) e mantenha ?sslmode=require.
DATABASE_URL="postgres://localhost:5432/execucao"

# Segredo usado para assinar/derivar dados sensíveis.
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-este-valor-em-producao"

# URL pública da aplicação (usada em cookies e links absolutos).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Opcional: chave de um provedor de LLM para o intake inteligente.
# Sem ela o sistema usa o motor heurístico local (offline).
LLM_API_KEY=""
